# Copy to .env and fill in. Never commit .env. Values are empty on purpose.
# The keeper reads real environment variables only. Load this file with your shell,
# a process manager or `node --env-file=.env dist/main.js`.

# --- Network (required) ---
# Network label, for example testnet or mainnet. Must match the passphrase below.
STELLAR_NETWORK=
# Stellar RPC server URL.
STELLAR_RPC_URL=
# Network passphrase. Testnet: "Test SDF Network ; September 2015".
# Mainnet: "Public Global Stellar Network ; September 2015".
STELLAR_NETWORK_PASSPHRASE=
# Deployed recurring contract id (starts with C).
CONTRACT_ID=

# --- Signing (optional) ---
# Secret key of the keeper account. Supply it at run time only. Leave empty to run read only.
KEEPER_SECRET_KEY=
# Set to true to forbid submitting any transaction even if a key is set.
READ_ONLY=
# Highest fee in stroops one charge may pay. A charge above this is not submitted. Empty = no limit.
MAX_FEE_STROOPS=

# --- Run ---
# Seconds between passes (sync, charge, deliver webhooks). Default 15.
POLL_INTERVAL_SECS=
# SQLite database file. Default ./keeper.sqlite
DB_PATH=
# Time limits in milliseconds. Defaults: 15000 for reads and simulation, 60000 for submitting.
RPC_TIMEOUT_MS=
TX_TIMEOUT_MS=

# --- Read API ---
# Default 127.0.0.1 and 8080.
API_HOST=
API_PORT=
# Browser origins allowed to call the API, comma separated, for example https://dash.example.com.
# Use * to allow any. Empty = no CORS headers.
CORS_ORIGINS=

# --- Webhooks to merchants (optional) ---
# JSON: merchant address -> { url, secretEnv }.
# secretEnv names another variable that holds that merchant's signing secret (at least 16 characters).
# Example: {"G...MERCHANT":{"url":"https://example.com/hooks","secretEnv":"WEBHOOK_SECRET_MERCHANT_1"}}
WEBHOOK_CONFIG=
WEBHOOK_SECRET_MERCHANT_1=
