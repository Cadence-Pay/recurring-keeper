{
  "name": "recurring-keeper",
  "version": "0.1.0",
  "description": "Keeper service for Stellar Recurring: submits due charges, sends webhooks, serves a read API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cadence-Pay/recurring-keeper.git"
  },
  "homepage": "https://github.com/Cadence-Pay/recurring-keeper#readme",
  "bugs": {
    "url": "https://github.com/Cadence-Pay/recurring-keeper/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "bin": {
    "recurring-keeper": "dist/main.js"
  }
}
